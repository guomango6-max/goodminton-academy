# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev-*.log

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local Supabase CLI link/cache metadata
/supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts

# local training automation
/training-inbox/
/training-notes/
/training-archive/
/raw-training-inbox/
/training-fetch-state.json
/scripts/training-automation.env.ps1
/scripts/external-training-sources.json
/scripts/bin/
/data/student-review/
/data/students/*.json
!/data/students/demo.json

# claude code / ide config
.claude/

# local browser smoke-test profiles
/.tmp-chrome-profile/
/.tmp-chrome-test/

# 外部抓取的原始材料（字幕、yt-dlp 产物、审计稿）。体积大、可重新抓取，
# 而且是第三方内容，不进版本库。
/tmp/
